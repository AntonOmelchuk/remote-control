{
  "expo": {
    "name": "Remote Control",
    "slug": "remote-control",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remotecontrol",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.antonomelchuk.remotecontrol",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Remote Control connects to your Mac on your local network."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#101211"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "uk"],
          "supportsRTL": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Remote Control to scan the pairing code on your Mac.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": ["ios"],
    "backgroundColor": "#F5F7F2",
    "locales": {
      "en": "./locales/en.json",
      "uk": "./locales/uk.json"
    }
  }
}
